# Copy to backend/.env for local use. On Railway/Render, set these as service env vars.

ENVIRONMENT=development
JWT_SECRET=replace-with-long-random-hex
DATABASE_URL=sqlite:///./indiavoice.db

# Production Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/baratx

# Comma-separated frontend origins (no spaces)
CORS_ORIGINS=http://localhost:5173

# Public frontend URL used in email verification links
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://barathx.com

# Outbound email (Cloudflare Email Routing is inbound-only)
EMAIL_FROM=BaratX <hello@barathx.com>
# Primary — Resend (verify barathx.com in Resend dashboard):
# RESEND_API_KEY=re_xxx
# Backup/debug — Gmail SMTP (App Password); ignored when RESEND_API_KEY is set:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# Google Sign-In (same Client ID on API + Vite frontend)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Frontend also needs: VITE_GOOGLE_CLIENT_ID=<same value>

# Admin registrations page (/admin) — required for /admin/stats, /admin/users,
# /admin/posts, /admin/recent-posts, and /admin/replies
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_SECRET=your-long-random-secret

# Password for official seed accounts (@baratx, @bharatvoices, @indiatech)
# After setting, restart API, then sign in with username `baratx` + this password.
# OFFICIAL_ACCOUNT_PASSWORD=your-strong-password

# SMS (MSG91) — leave empty in local/dev to keep demo OTP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BARATX

# Media storage — local folder in dev; R2/S3 in prod
MEDIA_BACKEND=local
# MEDIA_BACKEND=s3
# S3_BUCKET=baratx-media
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com
