# Copy to backend/.env for local use. On Railway/Render, set these as service env vars.

ENVIRONMENT=development
JWT_SECRET=replace-with-long-random-hex
DATABASE_URL=sqlite:///./indiavoice.db

# Production Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/baratx

# Comma-separated frontend origins (no spaces)
CORS_ORIGINS=http://localhost:5173
# Production should also allow Capacitor shells:
# CORS_ORIGINS=https://barathx.com,https://baratx.pages.dev,https://localhost,capacitor://localhost,ionic://localhost,http://localhost

# Public frontend URL used in email verification / reset links
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://barathx.com
# QA Railway service (required for correct verify/reset links):
# ENVIRONMENT=qa
# FRONTEND_URL=https://qa.barathx.com
# CORS_ORIGINS=https://qa.barathx.com

# Outbound email (Cloudflare Email Routing is inbound-only)
EMAIL_FROM=BarathX <hello@barathx.com>
# Primary — Resend (verify barathx.com in Resend dashboard):
# RESEND_API_KEY=re_xxx
# Backup/debug — Gmail SMTP (App Password); ignored when RESEND_API_KEY is set:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# Google Sign-In (same Client ID on API + Vite frontend)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Frontend also needs: VITE_GOOGLE_CLIENT_ID=<same web client value>
# Optional extra audiences (comma-separated), e.g. iOS client if not using iOSServerClientId:
# GOOGLE_CLIENT_IDS=yyyyy.apps.googleusercontent.com

# Admin registrations page (/admin) — required for /admin/stats, /admin/users,
# /admin/posts, /admin/recent-posts, and /admin/replies
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_SECRET=your-long-random-secret

# Password for official seed accounts (@baratx, @bharatvoices, @indiatech)
# After setting, restart API, then sign in with username `baratx` + this password.
# OFFICIAL_ACCOUNT_PASSWORD=your-strong-password

# Auto @baratx + @sharath first replies on community posts (welcome + content).
# Ongoing engage is OFF by default — set ENABLE_OFFICIAL_ENGAGE=1 to turn on.
# First-session welcome replies are ON by default (DISABLE_FIRST_SESSION_ENGAGE=1 to force off).
# ENABLE_OFFICIAL_ENGAGE=1
# DISABLE_FIRST_SESSION_ENGAGE=1

# Cloudflare Turnstile (bot gate for email / Google signup — phone OTP skips this).
# Create a widget at https://dash.cloudflare.com/?to=:/account/turnstile
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_SITE_KEY=0x...   # public site key (SPA reads via GET /public/config)
# Frontend build can also bake: VITE_TURNSTILE_SITE_KEY=<same site key>

# Daily digest peak posts between official accounts — OFF by default.
# ENABLE_DAILY_DIGEST=1

# Optional LLM rank/rewrite for Square/Arena suggestion lists (default off).
# AI_ASSIST_PROVIDER=none
# AI_ASSIST_PROVIDER=openai
# AI_ASSIST_API_KEY=
# AI_ASSIST_MODEL=gpt-4o-mini

# SMS (MSG91) — leave empty in local/dev to keep demo OTP.
# In production, phone OTP requires MSG91 or the API returns 503 (use Google/email).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BARATX

# Optional: JWT access lifetime in days (default 2). Password reset bumps token_version.
# JWT_ACCESS_DAYS=2
# EMAIL_UNSUB_DAYS=90

# Media storage
# auto (default) = Postgres blobs on Railway/production so redeploys don’t wipe images.
# local = filesystem only (local dev).
# s3/r2 = Cloudflare R2 / S3 (best at scale).
MEDIA_BACKEND=auto
# MEDIA_BACKEND=s3
# S3_BUCKET=baratx-media
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com
# MEDIA_DIR=/data/media
