# Copy to backend/.env for local use. On Railway/Render, set these as service env vars.

ENVIRONMENT=development
JWT_SECRET=replace-with-long-random-hex
DATABASE_URL=sqlite:///./indiavoice.db

# Production Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/baratx

# Comma-separated frontend origins (no spaces)
CORS_ORIGINS=http://localhost:5173

# SMS (MSG91) — leave empty in local/dev to keep demo OTP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BARATX

# Media storage — local folder in dev; R2/S3 in prod
MEDIA_BACKEND=local
# MEDIA_BACKEND=s3
# S3_BUCKET=baratx-media
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com
