# Local
VITE_API_BASE=http://localhost:8000
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Private ops/admin console (never public).
# The console is NOT at /admin (that path 404s on purpose). It lives at a secret
# owner-only path and is invisible (404) to logged-out visitors and non-owners.
#   VITE_OPS_CONSOLE_PATH  = the secret URL path (default "/bx-ops"). Set your own
#                            hard-to-guess value in production, e.g. /hq-9f3k-console
#   VITE_OPS_OWNER_USERNAMES = comma/space separated usernames allowed to see it
#                            (default "sharath"). Set to YOUR admin account handle.
# These are build-time vars: set them on the frontend host and rebuild/redeploy.
# The console still requires the ADMIN_SECRET unlock code (set on the API service).
# VITE_OPS_CONSOLE_PATH=/bx-ops
# VITE_OPS_OWNER_USERNAMES=sharath

# QA / staging frontend build (Cloudflare Pages QA project):
# VITE_API_BASE=https://baratx-qa.up.railway.app
# VITE_PUBLIC_URL=https://qa.barathx.com

# Production values live in .env.production (and Cloudflare Pages prod vars):
# VITE_API_BASE=https://baratx-production.up.railway.app
# VITE_PUBLIC_URL=https://barathx.com
