# Local
VITE_API_BASE=http://localhost:8000
# Web Google client (GIS + native Android webClientId / iOS serverClientId):
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# iOS-only Google OAuth client (required for native Google on iOS):
# VITE_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com

# QA / staging frontend build (Cloudflare Pages QA project):
# VITE_API_BASE=https://baratx-qa.up.railway.app
# VITE_PUBLIC_URL=https://qa.barathx.com

# Production values live in .env.production (and Cloudflare Pages prod vars):
# VITE_API_BASE=https://baratx-production.up.railway.app
# VITE_PUBLIC_URL=https://barathx.com

# Cloudflare Turnstile site key (bot gate on email/Google signup; phone OTP skips).
# Pair with TURNSTILE_SECRET_KEY on the API.
# VITE_TURNSTILE_SITE_KEY=0x...
